# Nerd Font (k8s-gui-shell only) — the desktop terminal actually renders a
# font, unlike k8s-shell's raw terminal (whatever client emulator the user
# already has open), so it's the one image that can install and default to
# one. FiraCode Nerd Font Mono backs both the terminal's own default font and
# the glyphs/powerline separators in k8s-gui-shell's starship theme (see
# k8s-gui-shell/packaging/install-nerd-font.sh).
NERD_FONTS_VERSION=v3.5.0
NERD_FONTS_FIRACODE_SHA256=32226dc81bb30ea421cdc49ba2134b93c2b43096992c829504a3004d2537420d
