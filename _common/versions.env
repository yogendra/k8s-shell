# Single source of truth for every pinned tool version used by _common/*.sh.
# Plain KEY=value, no logic — sourced by every install script (and fetch-binaries.sh)
# so k8s-shell and k8s-gui-shell can never drift onto different tool versions.
#
# To bump a version: change VERSION here, then re-derive the two SHA256 lines with:
#   curl -sL <url-for-that-arch> | shasum -a 256
#
# apt-repo pins
KUBECTL_APT_CHANNEL=v1.34
KUBECTL_VERSION=1.34.0-1.1

# vcf-cli apt repo pin (packages.broadcom.com) — public repo, no
# authentication required for the base CLI itself (VCF CLI plugins are a
# separate, token-gated registry flow, not wired up here yet).
VCF_CLI_VERSION=9.0.2

# webtop base image (k8s-gui-shell only) — pinned by digest, not the floating
# "ubuntu-xfce" tag, so an upstream lsio base update can't silently change
# assumptions underneath this image. Refresh with:
#   docker buildx imagetools inspect lscr.io/linuxserver/webtop:ubuntu-xfce --format '{{.Manifest.Digest}}'
WEBTOP_BASE_TAG=ubuntu-xfce@sha256:5079531006cfe3777969da37b3f61f8c82e4112a7a67c23b4e1f12e5976804eb

# --- binary-download tools: version + per-arch sha256 -----------------------

ISTIO_VERSION=1.22.2
